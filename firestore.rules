rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    // Public read collections (Catalog, Cities, Categories)
    match /cities/{cityId} {
      allow read: if true;
      allow write: if hasRole('admin');
    }

    match /stores/{storeId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (resource == null || resource.data.ownerId == request.auth.uid || hasRole('admin'));
      allow delete: if hasRole('admin');
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (hasRole('seller') || hasRole('admin'));
      allow delete: if isAuthenticated() && (hasRole('seller') || hasRole('admin'));
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || hasRole('admin');
      allow write: if isOwner(userId) || hasRole('admin');
    }

    // Addresses collection
    match /addresses/{addressId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Favorites collection
    match /favorites/{favoriteId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Orders collection: Customers, Sellers, and Assigned Riders
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.storeOwnerId == request.auth.uid ||
        resource.data.riderId == request.auth.uid ||
        hasRole('admin')
      );
      // Customers can create orders with their own customerId
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      // Updates are restricted based on role
      allow update: if isAuthenticated() && (
        // Customer can only cancel pending order
        (resource.data.customerId == request.auth.uid && request.resource.data.status == 'cancelled' && resource.data.status == 'pending') ||
        // Seller can update preparation status
        (resource.data.storeOwnerId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'statusTimestamps'])) ||
        // Rider can update pickup and delivery status
        (resource.data.riderId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'riderLocation', 'statusTimestamps'])) ||
        hasRole('admin')
      );
    }

    // Rider profiles and delivery assignments
    match /riders/{riderId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == riderId || hasRole('admin'));
    }

    match /deliveryAssignments/{assignmentId} {
      allow read: if isAuthenticated() && (resource.data.riderId == request.auth.uid || hasRole('admin'));
      allow write: if hasRole('admin') || (isAuthenticated() && resource.data.riderId == request.auth.uid);
    }
  }
}
